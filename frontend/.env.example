# GitHub Pages
VITE_BASE_PATH=/scheduler/
VITE_API_URL=https://schedule-manager-backend.onrender.com/api
VITE_SOCKET_URL=https://schedule-manager-backend.onrender.com

# Feature Flags
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_COLLABORATION=true
VITE_ENABLE_REALTIME=true

# Limits
VITE_MAX_TASKS_PER_DAY=50
VITE_MAX_TEAM_MEMBERS=10
VITE_IMAGE_UPLOAD_LIMIT=5242880

# Debug
VITE_DEBUG_MODE=false
VITE_MOCK_DATA=false
VITE_ASSET_BASE_URL=

# Analytics
VITE_ANALYTICS_ID=

# OAuth (optional)
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
