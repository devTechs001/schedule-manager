# ─────────────────────────────────────────────────────────────────────────────
# SchedAI frontend environment
#
# Vite inlines anything prefixed VITE_ into the client bundle at build time.
# That means every VITE_ value is public — it ships in the JavaScript. Only put
# identifiers here (client ids, public keys, URLs). Never a client *secret*,
# never an API key that is meant to be private.
#
# Two variables are read by vite.config.js via process.env rather than
# import.meta.env, because they are needed before bundling:
#   VITE_BASE_PATH, VITE_HMR_PORT, VITE_HMR_PROTOCOL
#
# Only VITE_API_URL matters for a normal local run; it defaults to /api, which
# the dev server proxies to the backend.
# ─────────────────────────────────────────────────────────────────────────────

# ── API ──────────────────────────────────────────────────────────────────────
# Base path or absolute origin for the REST API.
#   local dev          /api                (proxied to http://localhost:5000)
#   GitHub Pages       https://<backend>/api
# Leave the trailing /api off only if your proxy strips it — the client appends
# paths like /tasks directly. The health endpoint is derived by stripping /api.
VITE_API_URL=/api

# Socket.IO origin. Must be a full origin (scheme + host), not a path.
VITE_SOCKET_URL=http://localhost:5000

# ── Deployment ───────────────────────────────────────────────────────────────
# Sub-path the site is served from. GitHub Pages needs "/<repo-name>/";
# a root-hosted deployment leaves it as "/".
VITE_BASE_PATH=/

# ── Timeouts (milliseconds) ──────────────────────────────────────────────────
VITE_API_TIMEOUT=10000
VITE_SOCKET_TIMEOUT=30000

# ── Feature flags ────────────────────────────────────────────────────────────
# There are none, and that is deliberate. This file used to offer
# VITE_ENABLE_AI_FEATURES, VITE_ENABLE_NOTIFICATIONS, VITE_ENABLE_COLLABORATION
# and VITE_ENABLE_REALTIME. All four were read into config objects that nothing
# ever consulted, so flipping them changed no behaviour — they only made a
# half-configured deployment look feature-flagged.
#
# What actually decides each area:
#   AI             OPENAI_API_KEY on the server. Without it every AI endpoint
#                  returns 503 AI_UNAVAILABLE and the UI says so.
#   notifications  browser permission, granted from Settings.
#   collaboration  the workspace API. No data means an empty state.
#   realtime       VITE_SOCKET_URL below; the socket connects on its own.

# ── Limits ───────────────────────────────────────────────────────────────────
VITE_MAX_TASKS_PER_DAY=50
VITE_MAX_TEAM_MEMBERS=10
VITE_IMAGE_UPLOAD_LIMIT=5242880

# ── Debug ────────────────────────────────────────────────────────────────────
VITE_DEBUG_MODE=false
# Must stay false for real use: true swaps real requests for fixtures.
VITE_MOCK_DATA=false
VITE_ASSET_BASE_URL=

# ── OAuth client ids (public by design) ──────────────────────────────────────
# Only the *id* belongs here. The matching secret stays on the server. Empty
# means the sign-in button says "not configured on this deployment" instead of
# starting a flow that cannot finish.
VITE_GOOGLE_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=

# ── Integrations shown in Settings → Integrations ────────────────────────────
# Each entry is reported as available only when its id is present; otherwise
# the panel states that it is not configured. No integration invents a
# connection.
VITE_SLACK_CLIENT_ID=
VITE_TRELLO_CLIENT_ID=
VITE_DROPBOX_CLIENT_ID=

# ── Analytics ────────────────────────────────────────────────────────────────
# Public measurement id (e.g. GA4 "G-XXXXXXX"). Empty disables analytics.
VITE_ANALYTICS_ID=
