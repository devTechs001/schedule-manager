# ─────────────────────────────────────────────────────────────────────────────
# SchedAI backend environment
#
# Copy to .env and fill in. Every variable below is read by the code — this file
# is generated from the actual process.env call sites, not from memory. If you
# add a variable to the backend, add it here in the same commit.
#
#   cp .env.example .env
#
# Only three of these are required for the app to boot and work locally:
#   MONGODB_URI, JWT_SECRET, CLIENT_URL
# Everything else degrades to an honest "not configured" state when unset:
# AI features answer 503 AI_UNAVAILABLE, email quietly does not send, and the
# demo account is refused. Nothing invents data to cover a missing key.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Interface to bind. Set 0.0.0.0 inside a container so the port is reachable
# from outside it; localhost keeps it on loopback only.
HOST=localhost

# ── Database ─────────────────────────────────────────────────────────────────
# Required. The API boots without it but every data route answers 503
# DB_UNAVAILABLE rather than serving stale or invented records.
MONGODB_URI=mongodb://localhost:27017/ai-schedule-manager
# Atlas form:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
#
# Retry a failed initial connection instead of exiting. Set to false in CI or
# any environment where a missing database should fail fast.
DB_RETRY=true

# ── Auth ─────────────────────────────────────────────────────────────────────
# Required. Minimum 32 characters; the server refuses to issue tokens with the
# example value in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRE=7d
# SESSION_SECRET is deliberately NOT listed: this API is stateless (Bearer
# tokens, no express-session), so it was read into config.app and never used.
# The value that used to sit here did nothing.

# ── Client ───────────────────────────────────────────────────────────────────
# Required. Origin allowed by CORS. Comma-separate to allow more than one:
#   CLIENT_URL=http://localhost:5173,https://your-frontend.example.com
CLIENT_URL=http://localhost:5173

# ── Rate limiting ────────────────────────────────────────────────────────────
# Windows are fixed at 15 minutes. Limits default to 300 req / 10 login attempts
# in production and 1000 / 100 in development (see middleware/rateLimit.js).
# Only set these to override; leaving them unset is the recommended path.
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=10

# ── AI provider (optional) ───────────────────────────────────────────────────
# Without a key, every AI endpoint returns 503 with code AI_UNAVAILABLE and the
# UI says so. No endpoint falls back to canned text.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7

# ── Email / SMTP (optional) ──────────────────────────────────────────────────
# Without these, nothing is sent: password resets and invites are skipped and
# reported as unconfigured rather than pretending to deliver.
# For Gmail use an App Password, not your account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=AI Schedule Manager

# ── Uploads ──────────────────────────────────────────────────────────────────
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ── Demo mode ────────────────────────────────────────────────────────────────
# The one-click demo account. Enabled outside production by default; in
# production it stays off unless DEMO_MODE=true.
DEMO_MODE=true
# Credentials for the shared demo account. DEMO_PASSWORD is generated per boot
# when unset — set it explicitly only if a test harness needs a fixed value.
# DEMO_EMAIL=demo@schedai.app
# DEMO_NAME=Demo User
# DEMO_PASSWORD=

# ── Admin seeding (npm run seed:admin) ───────────────────────────────────────
# Leave ADMIN_PASSWORD empty to have the script generate one and print it.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ── Optional integrations ────────────────────────────────────────────────────
# Unset means "not configured": the corresponding Settings entry shows that
# state instead of a Connect button that cannot work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# REDIS_URL=redis://localhost:6379

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
